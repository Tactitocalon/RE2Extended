# RE2Extended - Ship Alert System (internal VoiceInterface)
#
# Switchable signal device. Uses the TurretEnemyBlack model, icon and collision.
# No native Class: is assigned; detection uses the RE2Extended
# ConditionDictionary bucket.
#
# The device plays verbal alerts and alarms for critical ship events on the
# local player's structure while this device is active.

{ +Block Name: VoiceInterface
  Material: Device
  Shape: ModelEntity
  ShowBlockName: true
  TemplateRoot: VoiceInterfaceBlocks
  Model: @models/Blocks/Turrets/TurretEnemyBlackPrefab
  Collide: "movement,bullet,rocket,melee,sight"
  DropMeshfile: Entities/Misc/DropContainerNewPrefab
  Place: Free
  RemoveOnSI: true
  StabilitySupport: false
  IsAccessible: true, type: bool
  IsActivateable: true
  IsActivateableInCP: true
  IsActivatedOnPlace: true
  IsLockable: true
  IsDuplicateable: false
  AllowedInBlueprint: true
  IsOxygenTight: false, display: true
  AllowPlacingAt: "Base,MS,SS,GV", display: true
  SizeInBlocks: "1,1,1", display: true
  StackSize: 1000
  BlockColor: "110,110,110"
  Category: Devices
  Group: cpgSignal
  IndexName: RE2Extended
  Info: bkiVoiceInterface, display: true
  CustomIcon: TurretEnemyBlack
  Mass: 50, type: float, display: true, formatter: Kilogram
  Volume: 10, type: float, display: true, formatter: Liter
  HitPoints: 250, type: int, display: true
  EnergyIn: 1, type: int, display: true, formatter: Watt
  CPUIn: 0, type: int, display: true
  MarketPrice: 1038, display: true
  ShowUser: Yes
  UnlockCost: 12, display: true
  UnlockLevel: 5, display: true
  TechTreeParent: Eden_TurretTargetPainter
  TechTreeNames: Misc
}

# Inventory/build-menu group, following the vanilla thruster/LCD pattern.
{ +Block Name: VoiceInterfaceBlocks
  IndexName: RE2Extended
  Group: cpgSignal
  Material: Device
  Shape: Invisible
  Place: Free
  DropMeshfile: Entities/Misc/DropContainerNewPrefab
  StackSize: 1000
  Category: Devices
  CustomIcon: TurretEnemyBlack
  ChildBlocks: "VoiceInterface"
  AllowPlacingAt: "Base,MS,SS,GV", display: true
  SizeInBlocks: "1,1,1", display: true
  BlockColor: "110,110,110"
  Info: bkiVoiceInterface, display: true
  IsOxygenTight: false, display: true
  Mass: 50, type: float, display: true, formatter: Kilogram
  Volume: 10, type: float, display: true, formatter: Liter
  HitPoints: 250, type: int, display: true
  EnergyIn: 1, type: int, display: true, formatter: Watt
  CPUIn: 0, type: int, display: true
  MarketPrice: 1038, display: true
  ShowUser: Yes
}
