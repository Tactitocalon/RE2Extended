# RE2Extended - Ship Alert System recipe
#
# 8 Electronics, 4 Steel Plates, 12 Carbon Substrate, 4 Computers, 10 Optical
# Fiber. MarketPrice above is the recipe material value (1038).

{ +Template Name: VoiceInterface
  CraftTime: 5
  Target: "SmallC,AdvC"
  { Child Inputs
    Electronics: 8
    SteelPlate: 4
    PlasticMaterial: 12
    Computer: 4
    OpticalFiber: 10
  }
}
