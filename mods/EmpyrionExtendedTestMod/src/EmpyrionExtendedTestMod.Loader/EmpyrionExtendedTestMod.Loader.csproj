<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net461</TargetFramework>
    <AssemblyName>EmpyrionExtendedTestMod</AssemblyName>
    <RootNamespace>EmpyrionExtendedTestMod</RootNamespace>
    <Version>0.7.0</Version>
    <LangVersion>7.3</LangVersion>
    <OutputPath>..\..\artifacts\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameRoot Condition="'$(GameRoot)' == ''">F:\SteamLibrary\steamapps\common\Empyrion - Galactic Survival</GameRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ModApi">
      <HintPath>$(GameRoot)\Client\Empyrion_Data\Managed\ModApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
